{
  "name": "peru-gov",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u AI_GATEWAY_API_KEY bun --bun next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "corpus:scan": "bun scripts/scan.ts",
    "corpus:crawl": "bun scripts/crawl.ts",
    "corpus:embed": "env -u AI_GATEWAY_API_KEY bun --env-file=.env.local scripts/embed-catalog.ts",
    "corpus:tree": "bun scripts/build-tree.ts",
    "eval": "env -u AI_GATEWAY_API_KEY bun --env-file=.env.local scripts/eval.ts",
    "dataset": "bun scripts/dataset.ts",
    "db:migrate": "env -u DATABASE_URL bun --env-file=.env.local scripts/db-migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.100",
    "@ai-sdk/react": "^4.0.125",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.122",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
